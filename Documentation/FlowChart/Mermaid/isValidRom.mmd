flowchart TD
    A([Start]) --> B["Trim whitespace from rom"]
    B --> C{"Length of rom < 23?"}

    C -- Yes --> D([Return false])
    C -- No --> E["token = first token (space-delimited)"]
    E --> F["count = 0"]

    F --> G{"token exists?"}

    G -- No --> H{"count == 8?"}
    H -- Yes --> I([Return true])
    H -- No --> J([Return false])

    G -- Yes --> K{"Token length == 2?"}
    K -- No --> D
    K -- Yes --> L["i = 0"]

    L --> M{"i < 2?"}

    M -- Yes --> N{"Character is hexadecimal?"}
    N -- No --> D
    N -- Yes --> O["i = i + 1"]
    O --> M

    M -- No --> P["count = count + 1"]
    P --> Q["token = next token"]
    Q --> G
