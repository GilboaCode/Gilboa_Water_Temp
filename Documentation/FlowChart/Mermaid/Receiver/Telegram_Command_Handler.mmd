flowchart TD

    A([Telegram Command Handler])

    A --> B{Command Selected}

    %% Debug ON
    B -->|/debug-on| C[command_debug_on]
    C --> D[Set debug_flag_from_receiver = true]
    D --> E[bot.sendMessage<br/>'Debug mode turned ON']

    %% Debug OFF
    B -->|/debug-off| F[command_debug_off]
    F --> G[Set debug_flag_from_receiver = false]
    G --> H[bot.sendMessage<br/>'Debug mode turned OFF']

    %% Reset
    B -->|/_RESET| I[command_reset]
    I --> J[Set telegramResetFlag = true]
    J --> K[bot.sendMessage<br/>'Receiver is resetting...']

    %% Firmware Update
    B -->|/_UPDATE| L[command_update]
    L --> M[bot.sendMessage<br/>'Updating Receiver firmware...']
    M --> N[Set telegramUpdateFlag = true]

    %% ROM Display
    B -->|/rom| O[command_rom]
    O --> P[Initialize runningText = ""]
    P --> Q{{Loop i = 0 to 13}}

    Q --> R[Append depthLabels]
    R --> S{ROM Address Exists?}

    S -->|Yes| T[Set currentRom = romTable]
    S -->|No| U[Set currentRom = 'Not Assigned']

    T --> V[Append ROM information]
    U --> V

    V --> W{More ROM Entries?}
    W -->|Yes| Q
    W -->|No| X[bot.sendMessage<br/>ROM List]

    %% Watchdog ON
    B -->|/WDT-on| Y[command_WDT_on]
    Y --> Z[Set watchdogEnableFlag = true]
    Z --> AA[saveOperatorVars]
    AA --> AB[bot.sendMessage<br/>'Watchdog timer turned ON']

    %% Watchdog OFF
    B -->|/WDT-off| AC[command_WDT_off]
    AC --> AD[Set watchdogEnableFlag = false]
    AD --> AE[saveOperatorVars]
    AE --> AF[bot.sendMessage<br/>'Watchdog timer turned OFF']
