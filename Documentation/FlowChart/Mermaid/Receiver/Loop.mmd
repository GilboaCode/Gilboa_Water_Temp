flowchart TD
    A([Start loop])

    A --> B[[checkHardResetPin]]
    B --> C[server.handleClient]

    C --> D{WiFi connected?}
    D -- No --> E[Print 'WiFi disconnected'<br/>ESP.restart]
    D -- Yes --> F{newPacketReceived?}

    F -- Yes --> G[Set newPacketReceived = false]
    G --> H[[updateOLED]]
    H --> I[[postTemperaturesToJsonPlaceholder]]
    I --> J[Print 'Posted temperatures']
    F -- No --> K

    J --> K

    %% Bottom water detection
    K --> L{Bottom water detected<br/>and alert not sent?}
    L -- Yes --> M[[sendEmailAlert<br/>Bottom Sensor]]
    M --> N[bottomWaterAlertSent = true]
    L -- No --> O{Bottom water == N?}
    O -- Yes --> P[bottomWaterAlertSent = false]
    O -- No --> Q

    N --> Q
    P --> Q

    %% Top water detection
    Q --> R{Top water detected<br/>and alert not sent?}
    R -- Yes --> S[[sendEmailAlert<br/>Top Sensor]]
    S --> T[topWaterAlertSent = true]
    R -- No --> U{Top water == N?}
    U -- Yes --> V[topWaterAlertSent = false]
    U -- No --> W

    T --> W
    V --> W

    %% Telegram
    W --> X[[checkTelegram]]

    %% Timer update
    X --> Y{30 seconds elapsed?}
    Y -- Yes --> Z[Update minCounter]
    Z --> AA[Update runningTimer]
    AA --> AB[Update runningDataPacketTimer]
    Y -- No --> AC

    AB --> AC

    %% Watchdog
    AC --> AD{Watchdog enabled?}
    AD -- No --> AE
    AD -- Yes --> AF{runningDataPacketTimer > 60<br/>senderSeenFlag<br/>!senderFailedFlag?}

    AF -- Yes --> AG[senderFailedFlag = true]
    AG --> AH[Print sender failure]
    AH --> AI[sendEmailAlert<br/>Sender Failure]
    AF -- No --> AE

    AI --> AE

    AE --> AJ[delay 100 ms]
    AJ --> AK([Next loop iteration])
